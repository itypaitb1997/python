# FarLink Agent Environment Configuration
FARLINK_API_URL=https://cloud.farlink.local/api
FARLINK_DB_PATH=/var/lib/farlink/agent.db
FARLINK_LOG_PATH=/var/log/farlink/agent.log
FARLINK_LOG_LEVEL=INFO

# Heartbeat interval in seconds
FARLINK_HEARTBEAT_INTERVAL=60

# HTTP Request Timeout in seconds
FARLINK_HTTP_TIMEOUT=10

# Hardware GPIO Pins (RPi CM5)
FARLINK_PIN_START=5
FARLINK_PIN_RESET=6

# Device Profile & Operation Mode (FarLink Go / FarLink Edge; Master / Slave / Standalone)
FARLINK_DEVICE_TYPE=FarLink Go
FARLINK_DEVICE_MODE=Standalone

