# FarLink Agent Environment Configuration
# API FarLink Cloud Web Server
FARLINK_API_URL=http://192.168.1.2:5000/api

# Database SQLite & Logging (lokal untuk development / testing)
FARLINK_DB_PATH=farlink_agent.db
FARLINK_LOG_PATH=farlink_agent.log
FARLINK_LOG_LEVEL=INFO

# Heartbeat interval (detik, default sesuai PRD: 60)
FARLINK_HEARTBEAT_INTERVAL=60

# HTTP Request Timeout (detik, default: 10)
FARLINK_HTTP_TIMEOUT=10

# Hardware GPIO Pins (Raspberry Pi CM5)
FARLINK_PIN_START=5
FARLINK_PIN_RESET=6
